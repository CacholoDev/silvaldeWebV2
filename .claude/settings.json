{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bin/ci:*)",
      "Bash(bin/rubocop:*)",
      "Bash(bin/brakeman:*)",
      "Bash(bin/bundler-audit:*)",
      "Bash(bin/importmap audit:*)",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(bin/rails db:prepare:*)",
      "Bash(bin/rails db:migrate:*)",
      "Bash(bin/rails routes:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git describe:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-parse:*)",
      "Bash(~/.claude/skills/project-review/scripts/rails_checks.sh:*)",
      "Bash(ruby ~/.claude/skills/project-review/scripts/check_i18n.rb:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Bash(git reset:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Bash(bin/rails generate scaffold:*)"
    ]
  }
}
