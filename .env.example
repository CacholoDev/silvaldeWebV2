DB_HOST=127.0.0.1
DB_PORT=3306
MYSQL_DATABASE=silvalde_web_v2
MYSQL_USER=silvalde_admin
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-root-password
RAILS_MAX_THREADS=5
APP_HOST=example.com
MAILER_FROM=from@example.com

# Outgoing email (password reset, order confirmations).
# Development: MailPit, the SMTP catcher the team uses — nothing leaves the
# machine and every message is browsable at http://localhost:8025. Start it:
#   podman run -d --name silvaldeWebV2_mailpit -p 1025:1025 -p 8025:8025 docker.io/axllent/mailpit
# With nothing configured the app defaults to 127.0.0.1:1025 (MailPit's SMTP).
# Production: the real provider, chosen in the go-live phase (docs/roadmap.md).
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Shop payment details shown to customers in the order emails (not secrets).
BANK_HOLDER=
BANK_IBAN=
BIZUM_PHONE=
