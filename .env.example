DB_HOST=127.0.0.1
DB_PORT=3306
MYSQL_DATABASE=silvalde_web_v2
MYSQL_USER=silvalde_admin
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-root-password
RAILS_MAX_THREADS=5

# Local development admin. db/seeds.rb uses these to create the first
# admin user. Leave them empty in shared/CI environments.
ADMIN_EMAIL=admin@silvalde.test
ADMIN_PASSWORD=change-this-admin-password
# Set to "1" to force-reset the admin password on the next db:seed.
ADMIN_RESET_PASSWORD=0

