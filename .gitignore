# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*
!/.env.example

# Editor tooling (not part of the repo).
/.ruby-lsp/

# Third-party agent skills are global (agent-dotfiles repo); a project-level
# `npx skills add` would only duplicate them. Project skills live in
# .claude/skills/ and ARE versioned. See docs/agent-tooling.md.
/.agents/
/skills-lock.json

# Personal Claude Code overrides (the shared .claude/settings.json is versioned).
/.claude/settings.local.json

# Node dependencies (Tailwind plugins and other frontend tooling).
/node_modules/

# Codegraph local index (not part of the repo).
/.codegraph/

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep
