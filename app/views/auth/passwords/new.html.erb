<div class="mx-auto w-full max-w-sm">
  <h1 class="font-serif text-3xl font-semibold tracking-tight"><%= t("passwords.new.title") %></h1>

  <%= form_with url: new_password_path, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :email, t("passwords.new.email"), class: "mb-1 block text-sm font-medium" %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email",
            class: "block w-full rounded-md border border-line-strong bg-surface px-3 py-2 text-ink shadow-sm focus:border-sage focus:outline-none focus:ring-2 focus:ring-sage/30" %>
    </div>

    <%= form.submit t("passwords.new.submit"),
          class: "w-full rounded-md bg-sage px-4 py-2 font-medium text-white hover:bg-sage-dark focus:outline-none focus:ring-2 focus:ring-sage focus:ring-offset-2" %>
  <% end %>
</div>
