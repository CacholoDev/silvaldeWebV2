<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; max-width: 32rem; margin: 0 auto; padding: 1.5rem;">
  <h1 style="font-size: 1.25rem; font-weight: 600; margin: 0 0 1rem;"><%= t("mailers.authentication.password_reset.subject") %></h1>
  <p><%= t("mailers.authentication.password_reset.greeting") %></p>
  <p><%= t("mailers.authentication.password_reset.body") %></p>
  <p style="margin: 1.5rem 0;">
    <a href="<%= @reset_url %>" style="display: inline-block; background: #1c1917; color: #fff; padding: 0.5rem 1rem; border-radius: 0.375rem; text-decoration: none;">
      <%= t("mailers.authentication.password_reset.cta") %>
    </a>
  </p>
  <p style="color: #57534e; font-size: 0.875rem;"><%= t("mailers.authentication.password_reset.expires") %></p>
  <p style="color: #57534e; font-size: 0.875rem;"><%= t("mailers.authentication.password_reset.ignore") %></p>
</div>
