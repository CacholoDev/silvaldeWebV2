<% content_for :title, "#{t("cart.page_title")} — #{t("app.name")}" %>

<h1 class="font-serif text-3xl font-semibold tracking-tight"><%= t("cart.page_title") %></h1>

<p id="cart_feedback" role="status" class="mt-3 text-sm text-sage-dark"></p>

<%# The frame wraps the lines and the total (or the empty state); Turbo
    Streams replace its content after every change, without reloading. %>
<turbo-frame id="cart_contents" class="mt-2 block">
  <%= render "carts/carts/contents", items: @items, total_cents: @total_cents %>
</turbo-frame>
