<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Silvalde Web V2" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Silvalde Web V2">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-stone-50 text-stone-900 antialiased">
    <% if user_signed_in? %>
      <header class="border-b border-stone-200 bg-white">
        <nav class="container mx-auto flex items-center justify-between px-5 py-4">
          <%= link_to "Silvalde Web", root_path, class: "text-lg font-semibold" %>
          <div class="flex items-center gap-4 text-sm">
            <span class="text-stone-600"><%= current_user.email_address %></span>
            <%= button_to t("authentication.flash.signed_out"), logout_path, method: :delete, class: "rounded border border-stone-300 px-3 py-1 hover:bg-stone-100" %>
          </div>
        </nav>
      </header>
    <% end %>

    <% flash.each do |level, message| %>
      <div class="container mx-auto mt-4 px-5">
        <div class="rounded border px-4 py-2 text-sm <%= level == "alert" ? "border-red-300 bg-red-50 text-red-800" : "border-emerald-300 bg-emerald-50 text-emerald-800" %>">
          <%= message %>
        </div>
      </div>
    <% end %>

    <main class="container mx-auto mt-10 px-5">
      <%= yield %>
    </main>
  </body>
</html>
