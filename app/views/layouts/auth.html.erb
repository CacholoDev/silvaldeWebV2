<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Silvalde Web V2" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-stone-50 text-stone-900 antialiased">
    <main class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-6 py-12">
      <header class="mb-8 text-center">
        <%= link_to "Silvalde Web", root_path, class: "text-xl font-semibold tracking-tight" %>
      </header>

      <% flash.each do |level, message| %>
        <div class="mb-4 rounded border px-4 py-2 text-sm <%= level == "alert" ? "border-red-300 bg-red-50 text-red-800" : "border-emerald-300 bg-emerald-50 text-emerald-800" %>">
          <%= message %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
