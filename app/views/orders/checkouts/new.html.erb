<% content_for :title, "#{t("checkout.page_title")} — #{t("app.name")}" %>

<div class="mx-auto w-full max-w-xl">
  <h1 class="font-serif text-3xl font-semibold tracking-tight"><%= t("checkout.page_title") %></h1>

  <%# The summary comes first: the customer reviews what she is buying
      (and how much it costs) before filling in the form. %>
  <section class="mt-6" aria-labelledby="checkout_summary_title">
    <h2 id="checkout_summary_title" class="text-lg font-medium"><%= t("checkout.summary_title") %></h2>

    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-sm">
        <caption class="sr-only"><%= t("checkout.summary_title") %></caption>
        <thead>
          <tr class="border-y border-line text-left text-muted">
            <th scope="col" class="py-2 pr-4 font-medium"><%= t("cart.item") %></th>
            <th scope="col" class="py-2 pr-4 font-medium"><%= t("cart.unit_price") %></th>
            <th scope="col" class="py-2 pr-4 font-medium"><%= t("cart.quantity") %></th>
            <th scope="col" class="py-2 font-medium"><%= t("cart.subtotal") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% @items.each do |item| %>
            <% decorated = decorate(item) %>
            <tr>
              <td class="py-3 pr-4 font-medium">
                <%= item.variant.product.name %>
                <span class="block text-xs text-muted"><%= item.variant.name %></span>
              </td>
              <td class="py-3 pr-4"><%= decorated.formatted_unit_price %></td>
              <td class="py-3 pr-4"><%= item.quantity %></td>
              <td class="py-3"><%= decorated.formatted_subtotal %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-4 flex items-baseline justify-between border-t border-line pt-4">
      <span class="text-lg font-semibold"><%= t("checkout.summary_total") %></span>
      <span class="text-lg font-semibold"><%= format_cents(@total_cents) %></span>
    </div>
  </section>

  <%= render "orders/checkouts/form" %>
</div>
