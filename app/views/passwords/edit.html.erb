<h1 class="mb-6 text-2xl font-semibold tracking-tight"><%= t("passwords.edit.title") %></h1>

<%= form_with model: User.new(password: nil), url: update_password_path, method: :patch, local: true, scope: :user, class: "space-y-4" do |f| %>
  <%= hidden_field_tag :user_id, @user_id %>
  <%= hidden_field_tag :token, @token %>

  <div>
    <%= f.label :password, class: "mb-1 block text-sm font-medium" %>
    <%= f.password_field :password, required: true, autofocus: true, autocomplete: "new-password", class: "w-full rounded border border-stone-300 px-3 py-2" %>
    <p class="mt-1 text-xs text-stone-500">Mínimo 8 caracteres.</p>
  </div>

  <div>
    <%= f.label :password_confirmation, class: "mb-1 block text-sm font-medium" %>
    <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "w-full rounded border border-stone-300 px-3 py-2" %>
  </div>

  <%= f.submit t("passwords.edit.submit"), class: "w-full rounded bg-stone-900 px-4 py-2 text-white hover:bg-stone-700 cursor-pointer" %>
<% end %>
