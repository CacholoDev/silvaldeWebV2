<h1 class="mb-2 text-2xl font-semibold tracking-tight"><%= t("passwords.new.title") %></h1>
<p class="mb-6 text-sm text-stone-600"><%= t("passwords.new.instructions") %></p>

<%= form_with url: passwords_path, local: true, class: "space-y-4" do |f| %>
  <div>
    <%= f.label :email_address, t("passwords.create.email_label"), class: "mb-1 block text-sm font-medium" %>
    <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "email", class: "w-full rounded border border-stone-300 px-3 py-2" %>
  </div>

  <%= f.submit t("passwords.new.submit"), class: "w-full rounded bg-stone-900 px-4 py-2 text-white hover:bg-stone-700 cursor-pointer" %>
<% end %>

<p class="mt-6 text-center text-sm text-stone-500">
  <%= link_to t("sessions.new.sign_in"), login_path, class: "font-medium text-stone-900 hover:underline" %>
</p>
