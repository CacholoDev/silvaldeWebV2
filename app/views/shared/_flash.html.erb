<% flash.each do |type, message| %>
  <% styles = type == "alert" ? "border-error/30 bg-error/5 text-error" : "border-sage/30 bg-sage/5 text-sage-dark" %>
  <div class="mb-4 rounded-md border px-4 py-3 text-sm <%= styles %>" role="<%= type == 'alert' ? 'alert' : 'status' %>">
    <%= message %>
  </div>
<% end %>
