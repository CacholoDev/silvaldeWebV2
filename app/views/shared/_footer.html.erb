<footer class="mt-20 border-t border-line bg-surface">
  <div class="container mx-auto grid gap-8 px-5 py-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-serif text-lg font-semibold"><%= t("app.name") %></p>
      <p class="mt-2 text-sm text-muted"><%= t("app.footer_tagline") %></p>
    </div>

    <nav aria-label="<%= t("catalog.footer.categories") %>">
      <h2 class="font-serif text-sm font-semibold"><%= t("catalog.footer.categories") %></h2>
      <ul class="mt-3 space-y-2 text-sm">
        <% @categories.each do |category| %>
          <li><%= link_to category.name, category_path(category.slug), class: "text-muted hover:text-ink" %></li>
        <% end %>
      </ul>
    </nav>

    <nav aria-label="<%= t("catalog.footer.shop") %>">
      <h2 class="font-serif text-sm font-semibold"><%= t("catalog.footer.shop") %></h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><%= link_to t("catalog.products.title"), products_path, class: "text-muted hover:text-ink" %></li>
        <li><%= link_to t("catalog.landing.all_products"), products_path, class: "text-muted hover:text-ink" %></li>
      </ul>
    </nav>

    <div>
      <h2 class="font-serif text-sm font-semibold"><%= t("catalog.footer.contact") %></h2>

      <%# Key-value layout: icon on the left, label and value on the right.
          Keeps the block compact without stacking headings. %>
      <dl class="mt-3 space-y-2 text-sm">
        <div class="flex items-center gap-2">
          <dt class="shrink-0">
            <%= image_tag brand_icon_path("mail.svg"), alt: "", aria: { hidden: true }, class: "h-4 w-4 fill-current text-muted" %>
            <span class="sr-only"><%= t("catalog.footer.email") %></span>
          </dt>
          <dd class="min-w-0">
            <a href="mailto:<%= Shop.email %>" class="break-all text-muted hover:text-ink"><%= Shop.email %></a>
          </dd>
        </div>

        <% Shop.phones.each_value do |phone| %>
          <div class="flex items-center gap-2">
            <dt class="shrink-0">
              <%= image_tag brand_icon_path("phone.svg"), alt: "", aria: { hidden: true }, class: "h-4 w-4 fill-current text-muted" %>
              <span class="sr-only"><%= t("catalog.footer.phone") %></span>
            </dt>
            <dd class="min-w-0">
              <a href="tel:<%= phone[:tel] %>" class="text-muted hover:text-ink">
                <span class="font-medium"><%= phone[:label] %></span>
                <span class="ml-1"><%= phone[:number] %></span>
              </a>
            </dd>
          </div>
        <% end %>

        <% Shop.social_links.each do |key, social| %>
          <div class="flex items-center gap-2">
            <dt class="shrink-0">
              <%= image_tag brand_icon_path("#{key}.svg"), alt: "", aria: { hidden: true }, class: "h-4 w-4 fill-current text-muted" %>
              <span class="sr-only"><%= t("catalog.footer.#{key}") %></span>
            </dt>
            <dd class="min-w-0">
              <%= link_to social[:name], social[:url],
                    target: "_blank", rel: "noopener noreferrer",
                    class: "text-muted hover:text-ink" %>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>
</footer>
