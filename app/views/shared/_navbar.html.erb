<header class="sticky top-0 z-10 border-b border-line bg-paper/95 backdrop-blur">
  <nav class="container mx-auto flex items-center justify-between gap-4 px-5 py-4" aria-label="<%= t("navigation.main") %>">
    <%= link_to "Silvalde Web", root_path, class: "font-serif text-lg font-semibold text-ink" %>

    <div class="flex items-center gap-4">
      <% if user_signed_in? %>
        <%= link_to t("navigation.sign_out"), logout_path, data: { turbo_method: :delete },
              class: "text-sm font-medium text-muted hover:text-ink" %>
      <% else %>
        <%= link_to t("navigation.sign_in"), login_path, class: "text-sm font-medium text-muted hover:text-ink" %>
        <%= link_to t("navigation.sign_up"), signup_path,
              class: "rounded-md bg-sage px-3 py-1.5 text-sm font-medium text-white hover:bg-sage-dark" %>
      <% end %>

      <%= render "shared/locale_switcher" %>
    </div>
  </nav>
</header>
