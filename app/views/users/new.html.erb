<h1><%= t("authentication.signup.title") %></h1>

<%= form_with model: @user, url: signup_path do |form| %>
  <div>
    <%= form.label :name, t("authentication.signup.name") %>
    <%= form.text_field :name, required: true, autofocus: true %>
  </div>

  <div>
    <%= form.label :email, t("authentication.signup.email") %>
    <%= form.email_field :email, required: true %>
  </div>

  <div>
    <%= form.label :password, t("authentication.signup.password") %>
    <%= form.password_field :password, required: true %>
  </div>

  <div>
    <%= form.label :password_confirmation, t("authentication.signup.password_confirmation") %>
    <%= form.password_field :password_confirmation, required: true %>
  </div>

  <%= form.submit t("authentication.signup.submit") %>
<% end %>
