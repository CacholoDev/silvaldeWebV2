<h1 class="mb-6 text-2xl font-semibold tracking-tight"><%= t("users.new.title") %></h1>

<%= form_with model: @user, url: signup_path, local: true, class: "space-y-4" do |f| %>
  <% if @user.errors.any? %>
    <div class="rounded border border-red-300 bg-red-50 px-4 py-2 text-sm text-red-800">
      <ul class="list-disc pl-5">
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "mb-1 block text-sm font-medium" %>
    <%= f.text_field :name, autocomplete: "name", class: "w-full rounded border border-stone-300 px-3 py-2" %>
  </div>

  <div>
    <%= f.label :email_address, class: "mb-1 block text-sm font-medium" %>
    <%= f.email_field :email_address, required: true, autocomplete: "email", class: "w-full rounded border border-stone-300 px-3 py-2" %>
  </div>

  <div>
    <%= f.label :password, class: "mb-1 block text-sm font-medium" %>
    <%= f.password_field :password, required: true, autocomplete: "new-password", class: "w-full rounded border border-stone-300 px-3 py-2" %>
    <p class="mt-1 text-xs text-stone-500">Mínimo 8 caracteres.</p>
  </div>

  <div>
    <%= f.label :password_confirmation, class: "mb-1 block text-sm font-medium" %>
    <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "w-full rounded border border-stone-300 px-3 py-2" %>
  </div>

  <%= f.submit t("users.new.submit"), class: "w-full rounded bg-stone-900 px-4 py-2 text-white hover:bg-stone-700 cursor-pointer" %>
<% end %>

<p class="mt-6 text-center text-sm text-stone-500">
  <%= t("users.new.have_account") %>
  <%= link_to t("users.new.sign_in"), login_path, class: "font-medium text-stone-900 hover:underline" %>
</p>
