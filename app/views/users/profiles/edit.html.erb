<div class="mx-auto w-full max-w-sm">
  <h1 class="font-serif text-3xl font-semibold tracking-tight"><%= t("profiles.edit.title") %></h1>

  <% if @user.errors.any? %>
    <div class="mt-6 rounded-md border border-error/30 bg-error/5 p-4 text-sm text-error" role="alert">
      <p class="font-medium"><%= t("authentication.errors_title") %></p>
      <ul class="mt-2 list-disc pl-5">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: profile_path, method: :patch, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :name, t("profiles.edit.name"), class: "mb-1 block text-sm font-medium" %>
      <%= form.text_field :name, required: true, autocomplete: "name",
            class: "block w-full rounded-md border border-line-strong bg-surface px-3 py-2 text-ink shadow-sm focus:border-sage focus:outline-none focus:ring-2 focus:ring-sage/30" %>
    </div>

    <div>
      <%= form.label :email, t("profiles.edit.email"), class: "mb-1 block text-sm font-medium" %>
      <%= form.email_field :email, required: true, autocomplete: "email",
            class: "block w-full rounded-md border border-line-strong bg-surface px-3 py-2 text-ink shadow-sm focus:border-sage focus:outline-none focus:ring-2 focus:ring-sage/30" %>
    </div>

    <label class="flex items-center gap-2 text-sm text-muted">
      <%= form.check_box :communications_consent, class: "rounded border-line text-sage focus:ring-sage" %>
      <%= t("communications_consent.label") %>
    </label>

    <%= form.submit t("profiles.edit.submit"),
          class: "w-full rounded-md bg-sage px-4 py-2 font-medium text-white hover:bg-sage-dark focus:outline-none focus:ring-2 focus:ring-sage focus:ring-offset-2" %>
  <% end %>
</div>
