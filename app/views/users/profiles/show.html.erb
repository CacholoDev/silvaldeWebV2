<div class="mx-auto w-full max-w-md">
  <h1 class="font-serif text-3xl font-semibold tracking-tight"><%= t("profiles.show.title") %></h1>

  <dl class="mt-8 space-y-4 text-sm">
    <div>
      <dt class="font-medium text-muted"><%= t("profiles.show.name") %></dt>
      <dd><%= @user.name %></dd>
    </div>
    <div>
      <dt class="font-medium text-muted"><%= t("profiles.show.email") %></dt>
      <dd><%= @user.email %></dd>
    </div>
  </dl>

  <p class="mt-8">
    <%= link_to t("profiles.show.edit"), edit_profile_path, class: "font-medium text-sage hover:underline" %>
  </p>
</div>
